        Input.Note = c.Note;
        Input.Telephone = c.Telephone;
        Input.Portable = c.Portable;
        Input.TelBis = c.TelBis;
        Input.Email = c.Email;
        Input.Email2 = c.Email2;
        Input.AssistanteCommercial = c.AssistanteCommercial;
        Input.ResponsableAchat = c.ResponsableAchat;
        Input.OpEnCours = string.IsNullOrEmpty(c.OpEnCours) ? null : c.OpEnCours;
        Input.StatusVente = string.IsNullOrEmpty(c.StatusVente) || c.StatusVente == "-1" ? null : c.StatusVente;
        Input.DateSaisie = c.DateSaisie;
        Input.HeureSaisie = c.HeureSaisie;
        Input.DateRappel = c.DateRappel;
        Input.HeureRappel = c.HeureRappel;
        Input.CleOpl = c.CleOpl;
        Input.StatutsClients = string.IsNullOrEmpty(c.StatutsClients) || c.StatutsClients == "-1" ? null : c.StatutsClients;
    }

    private string? ComputePhoningUrl()
    {
        var startId = SelectedCleOpl;
        if (startId is null && Results.Count > 0) startId = Results[0].CleOpl;
        if (startId is null) return null;

        var json = JsonSerializer.Serialize(BuildConditions());
        var encoded = Uri.EscapeDataString(json);
        return $"/parcours-client?mode=recherche&criteria={encoded}&start={startId}";
    }

    private void ShowPhoningSelectionError() =>
        Error = "Vous devez sélectionner une ligne, ou lancer une recherche (Rechercher Critères).";

    private void OpenSaveConfirm()
    {
        if (SelectedCleOpl is null)
        {
            Error = "aucun enregistrement à modifier";
            return;
        }
        ConfirmSaveOpen = true;
    }

    private Task ConfirmSave()
    {
        ConfirmSaveOpen = false;
        return SaveAsync(force: false);
    }

    private Task ForceApply()
    {
        ConflictDialogOpen = false;
        return SaveAsync(force: true);
    }

    private async Task ReloadAfterConflict()
    {
        ConflictDialogOpen = false;
        Conflicts = new();
        if (SelectedCleOpl is null) return;
        var refreshed = await ClientSvc.GetAsync(SelectedCleOpl.Value);
        if (refreshed is not null)
        {
            var idx = Results.FindIndex(r => r.CleOpl == SelectedCleOpl);
            if (idx >= 0) Results[idx] = refreshed;
        }
    }

    private async Task SaveAsync(bool force)
    {
        if (SelectedCleOpl is null) return;
        Submitting = true;
        Error = null;
        try
        {
            var existing = await ClientSvc.GetAsync(SelectedCleOpl.Value);
            if (existing is null)
            {
                Error = "Client introuvable.";
                return;
            }

            var baseline = ParcoursClientInput.FromEntity(existing);
            var patch = ParcoursClientInput.FromEntity(existing);
            if (!string.IsNullOrWhiteSpace(Input.Famille)) patch.Famille = Input.Famille;
            if (!string.IsNullOrWhiteSpace(Input.RaisonSociale)) patch.RaisonSociale = Input.RaisonSociale;
            if (!string.IsNullOrWhiteSpace(Input.Complement)) patch.Complement = Input.Complement;
            if (!string.IsNullOrWhiteSpace(Input.Franchise)) patch.Franchise = Input.Franchise;
            if (!string.IsNullOrWhiteSpace(Input.Franchise2)) patch.Franchise2 = Input.Franchise2;
            if (!string.IsNullOrWhiteSpace(Input.Franchise3)) patch.Franchise3 = Input.Franchise3;
            if (!string.IsNullOrWhiteSpace(Input.Franchise4)) patch.Franchise4 = Input.Franchise4;
            if (!string.IsNullOrWhiteSpace(Input.NAdherent)) patch.NAdherent = Input.NAdherent;
            if (!string.IsNullOrWhiteSpace(Input.NAdherent2)) patch.NAdherent2 = Input.NAdherent2;
            if (!string.IsNullOrWhiteSpace(Input.NAdherent3)) patch.NAdherent3 = Input.NAdherent3;
            if (!string.IsNullOrWhiteSpace(Input.NAdherent4)) patch.NAdherent4 = Input.NAdherent4;
            if (!string.IsNullOrWhiteSpace(Input.Rue)) patch.Rue = Input.Rue;
            if (!string.IsNullOrWhiteSpace(Input.Localisation1)) patch.Localisation1 = Input.Localisation1;
            if (!string.IsNullOrWhiteSpace(Input.Localisation2)) patch.Localisation2 = Input.Localisation2;
            if (!string.IsNullOrWhiteSpace(Input.Cp)) patch.Cp = Input.Cp;
            if (!string.IsNullOrWhiteSpace(Input.Ville)) patch.Ville = Input.Ville;
            if (!string.IsNullOrWhiteSpace(Input.Pays)) patch.Pays = Input.Pays;
            if (!string.IsNullOrWhiteSpace(Input.MagasinPrincipal)) patch.MagasinPrincipal = Input.MagasinPrincipal;
            if (!string.IsNullOrWhiteSpace(Input.Note)) patch.Note = Input.Note;
            if (!string.IsNullOrWhiteSpace(Input.Telephone)) patch.Telephone = Input.Telephone;
            if (!string.IsNullOrWhiteSpace(Input.Portable)) patch.Portable = Input.Portable;
            if (!string.IsNullOrWhiteSpace(Input.TelBis)) patch.TelBis = Input.TelBis;
            if (!string.IsNullOrWhiteSpace(Input.Email)) patch.Email = Input.Email;
            if (!string.IsNullOrWhiteSpace(Input.Email2)) patch.Email2 = Input.Email2;
            if (!string.IsNullOrWhiteSpace(Input.AssistanteCommercial)) patch.AssistanteCommercial = Input.AssistanteCommercial;
            if (!string.IsNullOrWhiteSpace(Input.ResponsableAchat)) patch.ResponsableAchat = Input.ResponsableAchat;
            if (!string.IsNullOrWhiteSpace(Input.OpEnCours)) patch.OpEnCours = Input.OpEnCours;
            if (!string.IsNullOrWhiteSpace(Input.StatusVente)) patch.StatusVente = Input.StatusVente;
            if (!string.IsNullOrWhiteSpace(Input.StatutsClients)) patch.StatutsClients = Input.StatutsClients;
            if (Input.DateSaisie is not null) patch.DateSaisie = Input.DateSaisie;
            if (Input.HeureSaisie is not null) patch.HeureSaisie = Input.HeureSaisie;
            if (Input.DateRappel is not null) patch.DateRappel = Input.DateRappel;
            if (Input.HeureRappel is not null) patch.HeureRappel = Input.HeureRappel;

            var result = await ClientSvc.UpdateFullWithConflictCheckAsync(
                SelectedCleOpl.Value, baseline, patch, force, excludeFromConflictCheck: new HashSet<string>());
            if (!result.Success)
            {
                Conflicts = result.Conflicts;
                ConflictDialogOpen = true;
                return;
            }

            var refreshed = await ClientSvc.GetAsync(SelectedCleOpl.Value);
            if (refreshed is not null)
            {
                var idx = Results.FindIndex(r => r.CleOpl == SelectedCleOpl);
                if (idx >= 0) Results[idx] = refreshed;
            }
        }
        catch (Exception ex)
        {
            Error = FriendlyError.ToUserMessage(ex);
        }
        finally
        {
            Submitting = false;
        }
    }

