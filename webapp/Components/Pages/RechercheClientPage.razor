@page "/recherche-client"
@using System.Text.Json
@inject ClientFilterService ClientFilterSvc
@inject ClientService ClientSvc
@inject NavigationManager Nav
@inject FamilleService FamilleSvc
@inject FranchiseService FranchiseSvc
@inject PaysService PaysSvc
@inject AssistanteService AssistanteSvc
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>@TabTitle</PageTitle>

<div class="rc-page page-flush">
    <div class="rc-topbar">
        <span class="rc-title">Recherche Client Multi-Critères</span>
    </div>

    @if (Error is not null)
    {
        <div class="alert">@Error</div>
    }

    <div class="rc-body" @onkeydown="HandleCriteriaKeyDown">
        <div class="rc-col">
            <div class="rc-field">
                <label>Famille :</label>
                <select class="text-input" value="@(Input.Famille ?? "")"
                        @onchange="e => Input.Famille = string.IsNullOrEmpty(e.Value?.ToString()) ? null : e.Value.ToString()">
                    <option value="">—</option>
                    @foreach (var f in FamilleOptions)
                    {
                        <option value="@f">@f</option>
                    }
                </select>
            </div>
            <div class="rc-field">
                <label>Raison Sociale :</label>
                <AutocompleteInput @bind-Value="Input.RaisonSociale" SuggestFunc='p => ClientFilterSvc.SuggestValuesAsync("raison_sociale", p)' />
            </div>
            <div class="rc-field">
                <label>Complement :</label>
                <AutocompleteInput @bind-Value="Input.Complement" SuggestFunc='p => ClientFilterSvc.SuggestValuesAsync("complement", p)' />
            </div>
            <div class="rc-field-row rc-franchise-row">
                <div class="rc-field-pair">
                    <div class="rc-field">
                        <label>Franchise 1 :</label>
                        <select class="text-input" value="@(Input.Franchise ?? "")"
                                @onchange="e => Input.Franchise = string.IsNullOrEmpty(e.Value?.ToString()) ? null : e.Value.ToString()">
                            <option value="">—</option>
                            @foreach (var f in FranchiseOptions)
                            {
                                <option value="@f">@f</option>
                            }
                        </select>
                    </div>
                    <div class="rc-field rc-adherent-field">
                        <label>N° Adhérent 1 :</label>
                        <AutocompleteInput @bind-Value="Input.NAdherent" SuggestFunc='p => ClientFilterSvc.SuggestValuesAsync("n_adherent", p)' />
                    </div>
                </div>
                <div class="rc-field-pair">
                    <div class="rc-field">
                        <label>Franchise 2 :</label>
                        <select class="text-input" value="@(Input.Franchise2 ?? "")"
                                @onchange="e => Input.Franchise2 = string.IsNullOrEmpty(e.Value?.ToString()) ? null : e.Value.ToString()">
                            <option value="">—</option>
                            @foreach (var f in FranchiseOptions)
                            {
                                <option value="@f">@f</option>
                            }
                        </select>
                    </div>
                    <div class="rc-field rc-adherent-field">
                        <label>N° Adhérent 2 :</label>
                        <AutocompleteInput @bind-Value="Input.NAdherent2" SuggestFunc='p => ClientFilterSvc.SuggestValuesAsync("n_adherent2", p)' />
                    </div>
                </div>
            </div>
            <div class="rc-field-row rc-franchise-row">
                <div class="rc-field-pair">
                    <div class="rc-field">
                        <label>Franchise 3 :</label>
                        <select class="text-input" value="@(Input.Franchise3 ?? "")"
                                @onchange="e => Input.Franchise3 = string.IsNullOrEmpty(e.Value?.ToString()) ? null : e.Value.ToString()">
                            <option value="">—</option>
                            @foreach (var f in FranchiseOptions)
                            {
                                <option value="@f">@f</option>
                            }
                        </select>
                    </div>
                    <div class="rc-field rc-adherent-field">
                        <label>N° Adhérent 3 :</label>
                        <AutocompleteInput @bind-Value="Input.NAdherent3" SuggestFunc='p => ClientFilterSvc.SuggestValuesAsync("n_adherent3", p)' />
                    </div>
                </div>
                <div class="rc-field-pair">
                    <div class="rc-field">
                        <label>Franchise 4 :</label>
                        <select class="text-input" value="@(Input.Franchise4 ?? "")"
                                @onchange="e => Input.Franchise4 = string.IsNullOrEmpty(e.Value?.ToString()) ? null : e.Value.ToString()">
                            <option value="">—</option>
                            @foreach (var f in FranchiseOptions)
                            {
                                <option value="@f">@f</option>
                            }
                        </select>
                    </div>
                    <div class="rc-field rc-adherent-field">
                        <label>N° Adhérent 4 :</label>
                        <AutocompleteInput @bind-Value="Input.NAdherent4" SuggestFunc='p => ClientFilterSvc.SuggestValuesAsync("n_adherent4", p)' />
                    </div>
                </div>
            </div>
            <div class="rc-field">
                <label>Rue :</label>
                <AutocompleteInput @bind-Value="Input.Rue" SuggestFunc='p => ClientFilterSvc.SuggestValuesAsync("rue", p)' />
            </div>
            <div class="rc-field-row">
                <div class="rc-field" style="flex: 1;">
                    <label>Localisation 1 :</label>
                    <AutocompleteInput @bind-Value="Input.Localisation1" SuggestFunc='p => ClientFilterSvc.SuggestValuesAsync("localisation_1", p)' />
                </div>
                <div class="rc-field" style="flex: 1;">
                    <label>Localisation 2 :</label>
                    <AutocompleteInput @bind-Value="Input.Localisation2" SuggestFunc='p => ClientFilterSvc.SuggestValuesAsync("localisation_2", p)' />
                </div>
            </div>
            <div class="rc-field-row">
                <div class="rc-field" style="flex: 0 0 100px;">
                    <label>Code Postal :</label>
                    <AutocompleteInput @bind-Value="Input.Cp" SuggestFunc='p => ClientFilterSvc.SuggestValuesAsync("cp", p)' />
                </div>
                <div class="rc-field" style="flex: 1;">
                    <label>Ville :</label>
                    <AutocompleteInput @bind-Value="Input.Ville" SuggestFunc='p => ClientFilterSvc.SuggestValuesAsync("ville", p)' />
                </div>
            </div>
            <div class="rc-field-row">
                <div class="rc-field" style="flex: 1;">
                    <label>Pays :</label>
                    <select class="text-input" value="@(Input.Pays ?? "")"
                            @onchange="e => Input.Pays = string.IsNullOrEmpty(e.Value?.ToString()) ? null : e.Value.ToString()">
                        <option value="">—</option>
                        @foreach (var p in PaysOptions)
                        {
                            <option value="@p">@p</option>
                        }
                    </select>
                </div>
                <div class="rc-field" style="flex: 2;">
                    <label>Magasin :</label>
                    <AutocompleteInput @bind-Value="Input.MagasinPrincipal" SuggestFunc='p => ClientFilterSvc.SuggestValuesAsync("magasin_principal", p)' />
                </div>
            </div>
        </div>

        <div class="rc-col">
            <div class="rc-field-row">
                <div class="rc-field" style="flex: 1;">
                    <label>Telephone :</label>
                    <AutocompleteInput @bind-Value="Input.Telephone" SuggestFunc='p => ClientFilterSvc.SuggestValuesAsync("telephone", p)' />
                </div>
                <div class="rc-field" style="flex: 1;">
                    <label>Portable :</label>
                    <AutocompleteInput @bind-Value="Input.Portable" SuggestFunc='p => ClientFilterSvc.SuggestValuesAsync("portable", p)' />
                </div>
            </div>
            <div class="rc-field">
                <label>Telephone bis :</label>
                <AutocompleteInput @bind-Value="Input.TelBis" SuggestFunc='p => ClientFilterSvc.SuggestValuesAsync("tel_bis", p)' />
            </div>
            <div class="rc-field">
                <label>Adresse Email :</label>
                <AutocompleteInput @bind-Value="Input.Email" SuggestFunc='p => ClientFilterSvc.SuggestValuesAsync("email", p)' />
            </div>
            <div class="rc-field">
                <label>Adresse Email 2 :</label>
                <AutocompleteInput @bind-Value="Input.Email2" SuggestFunc='p => ClientFilterSvc.SuggestValuesAsync("email2", p)' />
            </div>
            <div class="rc-field-row">
                <div class="rc-field" style="flex: 1;">
                    <label>Assist Commerciale :</label>
                    <select class="text-input" value="@(Input.AssistanteCommercial ?? "")"
                            @onchange="e => Input.AssistanteCommercial = string.IsNullOrEmpty(e.Value?.ToString()) ? null : e.Value.ToString()">
                        <option value="">—</option>
                        @foreach (var a in AssistanteOptions)
                        {
                            <option value="@a">@a</option>
                        }
                    </select>
                </div>
                <div class="rc-field" style="flex: 1;">
                    <label>Responsable Achat :</label>
                    <AutocompleteInput @bind-Value="Input.ResponsableAchat" SuggestFunc='p => ClientFilterSvc.SuggestValuesAsync("responsable_achat", p)' />
                </div>
            </div>
            <div class="rc-field-row">
                <div class="rc-field" style="flex: 1;">
                    <label>Opération en Cours :</label>
                    <select class="text-input" value="@(Input.OpEnCours ?? "")" @onchange="OnOperationChange">
                        <option value="">Toutes</option>
                        <option value="A Rappeler Mois">A Rappeler Mois</option>
                        <option value="A Rappeler Date">A Rappeler Date</option>
                        <option value="A Rappeler Date Heure">A Rappeler Date Heure</option>
                        <option value="Pas Intéressé">Pas Intéressé</option>
                        <option value="Vente en Cours">Vente en Cours</option>
                    </select>
                </div>
                <div class="rc-field" style="flex: 1;">
                    <label>Status de la Vente :</label>
                    <select class="text-input" value="@(Input.StatusVente ?? "")"
                            @onchange="e => Input.StatusVente = string.IsNullOrEmpty(e.Value?.ToString()) ? null : e.Value.ToString()">
                        <option value="">Tous</option>
                        <option value="Devis en cours">Devis</option>
                        <option value="Vente (BAT Original)">BAT</option>
                        <option value="Vente (BAT Signé)">BAT signé</option>
                        <option value="Vente (Bon de Commande)">Bon de commande</option>
                        <option value="Livré">Livré</option>
                        <option value="Vente Annulée">Vente Annulée</option>
                    </select>
                </div>
            </div>
            <div class="rc-field-row">
                <div class="rc-field" style="flex: 1;">
                    <label>Date Saisie :</label>
                    <DateInput Value="Input.DateSaisie" ValueChanged="v => Input.DateSaisie = v" />
                </div>
                <div class="rc-field" style="flex: 1;">
                    <label>Heure Saisie :</label>
                    <TimeInput Value="Input.HeureSaisie" ValueChanged="v => Input.HeureSaisie = v" />
                </div>
            </div>
            <div class="rc-field-row">
                <div class="rc-field" style="flex: 1;">
                    <label>Date Rappel :</label>
                    <DateInput Value="Input.DateRappel" ValueChanged="v => Input.DateRappel = v" />
                </div>
                <div class="rc-field" style="flex: 1;">
                    <label>Heure Rappel :</label>
                    <TimeInput Value="Input.HeureRappel" ValueChanged="v => Input.HeureRappel = v" />
                </div>
            </div>
            <div class="rc-field-row">
                <div class="rc-field" style="flex: 1;">
                    <label>Numéro Client :</label>
                    <input class="text-input" type="number" value="@Input.CleOpl"
                           @oninput="e => Input.CleOpl = long.TryParse(e.Value?.ToString(), out var v) ? v : null" />
                </div>
                <div class="rc-field" style="flex: 1;">
                    <label>Statuts clients :</label>
                    <select class="text-input" value="@(Input.StatutsClients ?? "")"
                            @onchange="e => Input.StatutsClients = string.IsNullOrEmpty(e.Value?.ToString()) ? null : e.Value.ToString()">
                        <option value="">—</option>
                        <option value="Payés">Payés</option>
                        <option value="Impayés">Impayés</option>
                        <option value="Bloqués">Bloqués</option>
                    </select>
                </div>
            </div>
            <div class="rc-field">
                <label>Note :</label>
                <textarea class="text-input" rows="2" @bind="Input.Note"></textarea>
            </div>
        </div>
    </div>

    <div class="grid-group show-grip">
    <div class="rc-actions">
        <button class="btn btn-primary" disabled="@Loading" @onclick="Search">Rechercher Critères</button>
        <button class="btn btn-default" disabled="@(SelectedCleOpl is null)" @onclick="LoadSelected">Charger Informations</button>
        @{ var phoningUrl = ComputePhoningUrl(); }
        @if (phoningUrl is not null)
        {
            <a href="@phoningUrl" target="_blank" class="btn btn-default" style="display: inline-block; text-decoration: none;">Ouvrir le Phoning</a>
        }
        else
        {
            <button class="btn btn-default" @onclick="ShowPhoningSelectionError">Ouvrir le Phoning</button>
        }
        <button class="btn btn-default" disabled="@(SelectedCleOpl is null || Submitting)" @onclick="OpenSaveConfirm">Enregistrer Modification</button>
        <button class="btn btn-default" @onclick="ClearAll">Tout Effacer</button>
        <button class="btn btn-default" @onclick='() => Nav.NavigateTo("/clients")'>Fermer</button>
        <span class="rc-count">@Results.Count enregistrement@(Results.Count != 1 ? "s" : "")</span>
    </div>

    <GridFilterClearAll Filter="Filter" OnFilterChanged="StateHasChanged" />
    <div class="rc-results table-wrap">
        <div style="@GridLayout.WrapperStyle(TotalWidth)">
            <div class="header-row" style="position: sticky; top: 0;" @ref="HeaderRowRef">
                @foreach (var col in Columns)
                {
                    <div class="cell" style="@GridLayout.ColStyle(col.Width, col == Columns[^1])">
                        <span class="col-sort-label @Sort.CssClass(col.Key)" @onclick='() => Sort.Toggle(col.Key)'>@col.Label @Sort.ArrowFor(col.Key)</span>
                        <ColumnFilterIcon Column="@col.Key" Label="@col.Label" Filter="Filter" OnFilterChanged="StateHasChanged" />
                        <span class="col-resize-handle" data-col-key="@col.Key"></span>
                    </div>
                }
            </div>
            @if (Loading)
            {
                <p class="dimmed">Recherche en cours…</p>
            }
            else if (Results.Count == 0 && HasSearched)
            {
                <p class="rc-zero-results">
                    Aucun client ne correspond aux critères saisis. Les critères se combinent tous
                    ensemble (un client doit correspondre à chacun d'eux) — essayez avec moins de
                    critères, ou vérifiez les valeurs saisies.
                </p>
            }
            else if (Results.Count == 0)
            {
                <p class="dimmed">Aucun résultat. Saisissez un ou plusieurs critères puis cliquez sur Rechercher Critères.</p>
            }
            else
            {
                <Virtualize Items="SortedResults" Context="c" ItemSize="34">
                    <div class="row @(c.CleOpl == SelectedCleOpl ? "selected" : "")"
                         @onclick="() => SelectedCleOpl = c.CleOpl">
                        @foreach (var col in Columns)
                        {
                            <div class="cell" style="@GridLayout.ColStyle(col.Width, col == Columns[^1])">
                                @if (col.Key == "statuts_clients" && StatutBadgeClass(c.StatutsClients) is { Length: > 0 } badgeClass)
                                {
                                    <span class="badge @badgeClass">@c.StatutsClients</span>
                                }
                                else if (col.Key == "validation_status")
                                {
                                    @if (c.ValidationStatus == "pending")
                                    {
                                        <span class="badge badge-info">Non validé</span>
                                    }
                                }
                                else
                                {
                                    @GetCellText(c, col.Key)
                                }
                            </div>
                        }
                    </div>
                </Virtualize>
            }
        </div>
    </div>
    </div>
</div>

@if (ConfirmSaveOpen)
{
    <div class="modal-backdrop" @onclick="() => ConfirmSaveOpen = false">
        <div class="modal" @onclick:stopPropagation="true">
            <h3>Confirmer</h3>
            <p class="confirm-text">
                Enregistrer les modifications sur le client sélectionné (Cle Opl @SelectedCleOpl) ?
                Seuls les champs renseignés ci-dessus seront modifiés.
            </p>
            <div class="modal-actions">
                <button class="btn btn-default" @onclick="() => ConfirmSaveOpen = false">Annuler</button>
                <button class="btn btn-primary" disabled="@Submitting" @onclick="ConfirmSave">Valider</button>
            </div>
        </div>
    </div>
}

@if (ConflictDialogOpen)
{
    <div class="modal-backdrop" @onclick="() => ConflictDialogOpen = false">
        <div class="modal" @onclick:stopPropagation="true">
            <h3>Conflit détecté</h3>
            <p class="confirm-text">
                Ce client a été modifié par quelqu'un d'autre pendant l'enregistrement.
                Voici les champs concernés :
            </p>
            <div class="conflict-list">
                @foreach (var c in Conflicts)
                {
                    <div class="conflict-row">
                        <span class="conflict-field">@c.Field</span>
                        <span class="conflict-values">Vous : @c.MyValue — Actuel : @c.CurrentValue</span>
                    </div>
                }
            </div>
            <div class="modal-actions">
                <button class="btn btn-default" @onclick="ReloadAfterConflict">Recharger</button>
                <button class="btn btn-primary" disabled="@Submitting" @onclick="ForceApply">Écraser quand même</button>
            </div>
        </div>
    </div>
}

@code {
    private class ClientSearchInput
    {
        public string? Famille { get; set; }
        public string? RaisonSociale { get; set; }
        public string? Complement { get; set; }
        public string? Franchise { get; set; }
        public string? Franchise2 { get; set; }
        public string? Franchise3 { get; set; }
        public string? Franchise4 { get; set; }
        public string? NAdherent { get; set; }
        public string? NAdherent2 { get; set; }
        public string? NAdherent3 { get; set; }
        public string? NAdherent4 { get; set; }
        public string? Rue { get; set; }
        public string? Localisation1 { get; set; }
        public string? Localisation2 { get; set; }
        public string? Cp { get; set; }
        public string? Ville { get; set; }
        public string? Pays { get; set; }
        public string? MagasinPrincipal { get; set; }
        public string? Note { get; set; }
        public string? Telephone { get; set; }
        public string? Portable { get; set; }
        public string? TelBis { get; set; }
        public string? Email { get; set; }
        public string? Email2 { get; set; }
        public string? AssistanteCommercial { get; set; }
        public string? ResponsableAchat { get; set; }
        public string? OpEnCours { get; set; }
        public string? StatusVente { get; set; }
        public DateOnly? DateSaisie { get; set; }
        public TimeOnly? HeureSaisie { get; set; }
        public DateOnly? DateRappel { get; set; }
        public TimeOnly? HeureRappel { get; set; }
        public long? CleOpl { get; set; }
        public string? StatutsClients { get; set; }
    }

    private class ColumnDef
    {
        public string Key { get; }
        public string Label { get; }
        public int Width { get; set; }

        public ColumnDef(string key, string label, int width)
        {
            Key = key;
            Label = label;
            Width = width;
        }
    }

    private readonly List<ColumnDef> Columns = new()
    {
        new("cle_opl", "N° Client", 80),
        new("famille", "Famille", 140),
        new("raison_sociale", "Raison Sociale", 200),
        new("complement", "Complement", 160),
        new("franchise", "Franchise", 140),
        new("franchise2", "Franchise 2", 140),
        new("franchise3", "Franchise 3", 140),
        new("franchise4", "Franchise 4", 140),
        new("n_adherent", "N° Adhérent", 110),
        new("n_adherent2", "N° Adhérent 2", 110),
        new("n_adherent3", "N° Adhérent 3", 110),
        new("n_adherent4", "N° Adhérent 4", 110),
        new("rue", "Rue", 160),
        new("localisation_1", "Localisation 1", 140),
        new("localisation_2", "Localisation 2", 140),
        new("cp", "Code Postal", 90),
        new("ville", "Ville", 140),
        new("pays", "Pays", 120),
        new("telephone", "Telephone", 110),
        new("portable", "Portable", 110),
        new("email", "Email", 180),
        new("email2", "Email 2", 180),
        new("assistante_commercial", "Assistante Commerciale", 180),
        new("responsable_achat", "Responsable Achat", 160),
        new("op_en_cours", "Opération en Cours", 160),
        new("status_vente", "Status Vente", 140),
        new("date_saisie", "Date Saisie", 100),
        new("heure_saisie", "Heure Saisie", 90),
        new("date_rappel", "Date Rappel", 100),
        new("heure_rappel", "Heure Rappel", 90),
        new("note", "Note", 200),
        new("statuts_clients", "Statut Client", 140),
        new("validation_status", "Validation", 110),
    };

    private int TotalWidth => Columns.Sum(c => c.Width);

    private string TabTitle
    {
        get
        {
            if (HasSearched)
            {
                return $"{Results.Count} résultat{(Results.Count != 1 ? "s" : "")} – Recherche Client";
            }

            var criterion = Input.RaisonSociale?.Trim() is { Length: > 0 } rs ? rs
                : Input.Ville?.Trim() is { Length: > 0 } v ? v
                : Input.Telephone?.Trim() is { Length: > 0 } t ? t
                : Input.Portable?.Trim() is { Length: > 0 } p ? p
                : Input.Email?.Trim() is { Length: > 0 } e ? e
                : null;

            return criterion is not null ? $"Recherche: {criterion}" : "Recherche Client Multi-Critères";
        }
    }

    private ClientSearchInput Input = new();
    private List<FranceOptique> Results = new();
    private long? SelectedCleOpl;
    private bool Loading;
    private bool Submitting;
    private bool ConfirmSaveOpen;
    private bool ConflictDialogOpen;
    private List<FieldConflict> Conflicts = new();
    private string? Error;
    private bool HasSearched;
    private List<string> FamilleOptions = new();
    private List<string> FranchiseOptions = new();
    private List<string> PaysOptions = new();
    private List<string> AssistanteOptions = new();
    private readonly SortState Sort = new();
    private readonly GridFilterState Filter = new();

    private List<FranceOptique> SortedResults => GridSort.Apply(GridFilter.Apply(Results, Filter, GetCellText), Sort, GetCellText);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            FamilleOptions = await FamilleSvc.ListAsync();
            FranchiseOptions = await FranchiseSvc.ListAsync();
            PaysOptions = (await PaysSvc.ListAsync()).Select(p => p.NomPays).ToList();
            AssistanteOptions = (await AssistanteSvc.ListAsync()).Select(a => a.PrenomNom).ToList();
        }
        catch (Exception ex)
        {
            Error = FriendlyError.ToUserMessage(ex);
        }
    }

    private ElementReference HeaderRowRef;
    private DotNetObjectReference<RechercheClientPage>? ResizeDotNetRef;
    private bool ResizeAttached;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!ResizeAttached)
        {
            ResizeAttached = true;
            ResizeDotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("mafaliColumnResize.attach", HeaderRowRef, ResizeDotNetRef);
        }
    }

    [JSInvokable]
    public void OnColumnResized(string key, int width)
    {
        var col = Columns.FirstOrDefault(c => c.Key == key);
        if (col is null) return;
        col.Width = width;
        StateHasChanged();
    }

    public class ColumnAutoFitData
    {
        public string Header { get; set; } = "";
        public List<string> Values { get; set; } = new();
    }

    [JSInvokable]
    public ColumnAutoFitData GetColumnAutoFitData(string key)
    {
        var col = Columns.FirstOrDefault(c => c.Key == key);
        return new ColumnAutoFitData
        {
            Header = col?.Label ?? "",
            Values = Results.Select(item => GetCellText(item, key)).ToList(),
        };
    }

    public async ValueTask DisposeAsync()
    {
        if (ResizeAttached)
        {
            try
            {
                await JS.InvokeVoidAsync("mafaliColumnResize.detach", HeaderRowRef);
            }
            catch (JSDisconnectedException)
            {
            }
        }
        ResizeDotNetRef?.Dispose();
    }

    private void OnOperationChange(ChangeEventArgs e)
    {
        Input.OpEnCours = string.IsNullOrEmpty(e.Value?.ToString()) ? null : e.Value.ToString();
    }

    private async Task HandleCriteriaKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !Loading)
        {
            await Search();
        }
    }

    private async Task Search()
    {
        Loading = true;
        Error = null;
        try
        {
            Results = (await ClientFilterSvc.SearchAsync(BuildConditions())).Rows;
            SelectedCleOpl = null;
            HasSearched = true;
        }
        catch (Exception ex)
        {
            Error = FriendlyError.ToUserMessage(ex);
        }
        finally
        {
            Loading = false;
        }
    }

    private async Task ClearAll()
    {
        Input = new();
        SelectedCleOpl = null;
        await Search();
    }

    private List<Condition> BuildConditions()
    {
        var list = new List<Condition>();

        void AddText(string field, string? value)
        {
            if (!string.IsNullOrWhiteSpace(value))
                list.Add(new Condition { Field = field, Operator = Operator.Contains, Values = new() { value } });
        }

        void AddEq(string field, string? value)
        {
            if (!string.IsNullOrWhiteSpace(value))
                list.Add(new Condition { Field = field, Operator = Operator.Eq, Values = new() { value } });
        }

        AddEq("famille", Input.Famille);
        AddText("raison_sociale", Input.RaisonSociale);
        AddText("complement", Input.Complement);
        AddEq(ClientFilterService.FranchiseAnyField, Input.Franchise);
        AddEq(ClientFilterService.FranchiseAnyField, Input.Franchise2);
        AddEq(ClientFilterService.FranchiseAnyField, Input.Franchise3);
        AddEq(ClientFilterService.FranchiseAnyField, Input.Franchise4);
        AddText("n_adherent", Input.NAdherent);
        AddText("n_adherent2", Input.NAdherent2);
        AddText("n_adherent3", Input.NAdherent3);
        AddText("n_adherent4", Input.NAdherent4);
        AddText("rue", Input.Rue);
        AddText("localisation_1", Input.Localisation1);
        AddText("localisation_2", Input.Localisation2);
        AddText("cp", Input.Cp);
        AddText("ville", Input.Ville);
        AddEq("pays", Input.Pays);
        AddText("magasin_principal", Input.MagasinPrincipal);
        AddText("note", Input.Note);
        AddText("telephone", Input.Telephone);
        AddText("portable", Input.Portable);
        AddText("tel_bis", Input.TelBis);
        AddText("email", Input.Email);
        AddText("email2", Input.Email2);
        AddEq("assistante_commercial", Input.AssistanteCommercial);
        AddText("responsable_achat", Input.ResponsableAchat);
        AddEq("op_en_cours", Input.OpEnCours);
        AddEq("status_vente", Input.StatusVente);
        AddEq("statuts_clients", Input.StatutsClients);

        if (Input.CleOpl is not null)
            list.Add(new Condition { Field = "cle_opl", Operator = Operator.Eq, Values = new() { Input.CleOpl.Value.ToString() } });
        if (Input.DateSaisie is not null)
            list.Add(new Condition { Field = "date_saisie", Operator = Operator.Eq, Values = new() { Input.DateSaisie.Value.ToString("yyyy-MM-dd") } });
        if (Input.HeureSaisie is not null)
            list.Add(new Condition { Field = "heure_saisie", Operator = Operator.Eq, Values = new() { Input.HeureSaisie.Value.ToString("HH:mm") } });
        if (Input.DateRappel is not null)
            list.Add(new Condition { Field = "date_rappel", Operator = Operator.Eq, Values = new() { Input.DateRappel.Value.ToString("yyyy-MM-dd") } });
        if (Input.HeureRappel is not null)
            list.Add(new Condition { Field = "heure_rappel", Operator = Operator.Eq, Values = new() { Input.HeureRappel.Value.ToString("HH:mm") } });

        return list;
    }

    private void LoadSelected()
    {
        var c = Results.FirstOrDefault(r => r.CleOpl == SelectedCleOpl);
        if (c is null) return;
        Input.Famille = c.Famille;
        Input.RaisonSociale = c.RaisonSociale;
        Input.Complement = c.Complement;
        Input.Franchise = c.Franchise;
        Input.Franchise2 = c.Franchise2;
        Input.Franchise3 = c.Franchise3;
        Input.Franchise4 = c.Franchise4;
        Input.NAdherent = c.NAdherent;
        Input.NAdherent2 = c.NAdherent2;
        Input.NAdherent3 = c.NAdherent3;
        Input.NAdherent4 = c.NAdherent4;
        Input.Rue = c.Rue;
        Input.Localisation1 = c.Localisation1;
        Input.Localisation2 = c.Localisation2;
        Input.Cp = c.Cp;
        Input.Ville = c.Ville;
