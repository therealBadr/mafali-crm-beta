@page "/fichier-historique"
@attribute [Authorize(Roles = "admin,assistant")]
@using Microsoft.AspNetCore.Components.Web.Virtualization
@implements IAsyncDisposable
@inject HistoriqueService HistoriqueSvc
@inject HistoriqueFilterService HistoFilterSvc
@inject FiltreHistoriqueService FiltreHistoSvc
@inject AssistanteService AssistanteSvc
@inject CurrentUserService CurrentUser
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Fichier des Historiques</PageTitle>

<div class="page page-flush wb">
<div class="toolbar">
    <span class="title">Table des Historiques</span>
    <div class="actions">
        <button class="btn btn-primary" @onclick="OpenCreate">Nouveau</button>
        <button class="btn btn-outline" disabled="@(Selected is null)" @onclick="OpenEdit">Modifier</button>
        <button class="btn btn-outline" disabled="@(Selected is null)" @onclick="OpenDeleteConfirm">Supprimer</button>
    </div>
</div>

<div class="search-bar">
    <label style="font-size: 13px; color: var(--color-muted-foreground);">Assistante :</label>
    <select class="search-input" style="min-width: 180px;" value="@SelectedAssistante" disabled="@(!CanViewAll)" @onchange="OnAssistanteChange">
        <option value="">Sélectionner…</option>
        @foreach (var a in Assistantes)
        {
            <option value="@a">@a</option>
        }
    </select>
    <label style="font-size: 13px; color: var(--color-muted-foreground);">Filtre :</label>
    <select class="search-input" style="min-width: 220px;" value="@SelectedFiltreNom" disabled="@(SelectedAssistante is null)" @onchange="OnFiltreChange">
        <option value="">&lt; Aucun &gt;</option>
        @foreach (var f in Filtres)
        {
            <option value="@f.NomFiltre">@f.NomFiltre</option>
        }
    </select>
    <span class="result-count">
        @if (LoadedItems.Count < TotalCount && !_hasMore)
        {
            @($"{LoadedItems.Count} sur {TotalCount} enregistrements (affichage limité — utilisez un filtre pour affiner)")
        }
        else
        {
            @($"{TotalCount} enregistrement{(TotalCount != 1 ? "s" : "")}")
        }
    </span>
</div>

@if (Error is not null)
{
    <div class="alert">@Error</div>
}

<div class="grid-group">
<GridFilterClearAll Filter="Filter" OnFilterChanged="StateHasChanged" />
<div class="table-wrap" style="overflow-x: auto;" @ref="TableWrapRef">
    <div style="@GridLayout.WrapperStyle(TotalWidth)">
        <div class="header-row" style="position: sticky; top: 0;">
            @foreach (var col in Columns)
            {
                <div class="cell @Sort.CssClass(col.Key)" style="@GridLayout.ColStyle(col.Width, col == Columns[^1])" @onclick='() => Sort.Toggle(col.Key)'>
                    @col.Label @Sort.ArrowFor(col.Key)
                    <ColumnFilterIcon Column="@col.Key" Label="@col.Label" Filter="Filter" OnFilterChanged="StateHasChanged" />
                </div>
            }
        </div>
        <Virtualize Items="SortedItems" Context="h" ItemSize="34">
            <div class="row @(h.IdHisto == Selected ? "selected" : "")"
                 @onclick="() => Select(h.IdHisto)"
                 @ondblclick="() => OpenEditRow(h.IdHisto)">
                @foreach (var col in Columns)
                {
                    <div class="cell" style="@GridLayout.ColStyle(col.Width, col == Columns[^1])">
                        @if (col.Key == "statuts_clients" && StatutBadgeClass(h.StatutsClients) is { Length: > 0 } badgeClass)
                        {
                            <span class="badge @badgeClass">@h.StatutsClients</span>
                        }
                        else
                        {
                            @GetCellText(h, col.Key)
                        }
                    </div>
                }
            </div>
        </Virtualize>
        @if (_loadingMore)
        {
            <div class="row" style="cursor: default;">
                <div class="cell dimmed" style="flex: 1;">Chargement…</div>
            </div>
        }
    </div>
</div>
</div>
<p class="count">
    @if (LoadedItems.Count < TotalCount && !_hasMore)
    {
        @($"{LoadedItems.Count} sur {TotalCount} enregistrements (affichage limité — utilisez un filtre pour affiner)")
    }
    else
    {
        @($"{TotalCount} enregistrement{(TotalCount != 1 ? "s" : "")}")
    }
</p>
</div>

@if (ConfirmDeleteOpen)
{
    <div class="modal-backdrop wb" @onclick="() => ConfirmDeleteOpen = false">
        <div class="modal" @onclick:stopPropagation="true">
            <h3>Confirmer la suppression</h3>
            <p class="confirm-text">Voulez-vous vraiment supprimer la ligne ?</p>
            <div class="modal-actions">
                <button class="btn btn-default" @onclick="() => ConfirmDeleteOpen = false">Annuler</button>
                <button class="btn btn-primary" disabled="@Submitting" @onclick="ConfirmDelete">Supprimer</button>
            </div>
        </div>
    </div>
}

@code {
    private record ColumnDef(string Key, string Label, int Width);

    private readonly List<ColumnDef> Columns = new()
    {
        new("num_client", "N° Client", 90),
        new("date_saisie", "Date Saisie", 100),
        new("heure_saisie", "Heure Saisie", 90),
        new("assistante_commercial", "Assistante Commerciale", 180),
        new("date_rappel", "Date Rappel", 100),
        new("heure_rappel", "Heure Rappel", 90),
        new("operation", "Opération", 220),
        new("status_vente", "Status Vente", 140),
        new("note", "Note", 260),
        new("franchise", "Franchise", 140),
        new("n_adherent", "N° Adhérent", 110),
        new("franchise2", "Franchise 2", 140),
        new("n_adherent2", "N° Adhérent 2", 110),
        new("franchise3", "Franchise 3", 140),
        new("n_adherent3", "N° Adhérent 3", 110),
        new("franchise4", "Franchise 4", 140),
        new("n_adherent4", "N° Adhérent 4", 110),
        new("raison_sociale", "Raison Sociale", 200),
        new("cp", "Code Postal", 90),
        new("ville", "Ville", 140),
        new("statuts_clients", "Statuts Clients", 140),
        new("magasin_principal", "Magasin Principal", 160),
        new("id_histo", "ID Auto", 90),
    };

    private int TotalWidth => Columns.Sum(c => c.Width);

    private const int BatchSize = 100;
    private const int MaxLoadedRows = 5000;

    private List<Historique> LoadedItems = new();
    private long? _lastLoadedId;
    private bool _hasMore = true;
    private bool _loadingMore;
    private ElementReference TableWrapRef;
    private DotNetObjectReference<FichierHistoriquePage>? _dotNetRef;

    private int TotalCount;
    private long? Selected;
    private bool Submitting;
    private bool ConfirmDeleteOpen;
    private string? Error;

    private List<string> Assistantes = new();
    private string? SelectedAssistante;
    private List<FiltreHistorique> Filtres = new();
    private string? SelectedFiltreNom;
    private bool CanViewAll;
    private readonly SortState Sort = new();
    private readonly GridFilterState Filter = new();

    private List<Historique> SortedItems => GridSort.Apply(GridFilter.Apply(LoadedItems, Filter, GetCellText), Sort, GetCellText);

    protected override async Task OnInitializedAsync()
    {
        CanViewAll = await CurrentUser.CanViewAllFiltersAsync();
        var currentLogin = await CurrentUser.GetLoginAsync();

        try
        {
            Assistantes = (await AssistanteSvc.ListAsync()).Select(a => a.PrenomNom).ToList();
        }
        catch (Exception ex)
        {
            Error = FriendlyError.ToUserMessage(ex);
        }

        if (!CanViewAll && currentLogin is not null)
        {
            Assistantes = new List<string> { currentLogin };
            await SelectAssistante(currentLogin);
        }

        await RefreshCount();
        await LoadInitial();
    }

    private async Task OnAssistanteChange(ChangeEventArgs e)
    {
        var value = string.IsNullOrEmpty(e.Value?.ToString()) ? null : e.Value.ToString();
        await SelectAssistante(value);
        await ClearFilter();
    }

    private async Task SelectAssistante(string? assistante)
    {
        SelectedAssistante = assistante;
        SelectedFiltreNom = null;
        Filtres = new();
        if (SelectedAssistante is null) return;

        try
        {
            Filtres = await FiltreHistoSvc.ListByOperatorAsync(SelectedAssistante);
            Error = null;
        }
        catch (Exception ex)
        {
            Error = FriendlyError.ToUserMessage(ex);
        }
    }

    private async Task OnFiltreChange(ChangeEventArgs e)
    {
        var nom = e.Value?.ToString();
        SelectedFiltreNom = string.IsNullOrEmpty(nom) ? null : nom;

        if (SelectedFiltreNom is null)
        {
            await ClearFilter();
            return;
        }

        var filtre = Filtres.FirstOrDefault(f => f.NomFiltre == SelectedFiltreNom);
        if (filtre is null) return;

        Error = null;
        try
        {
            var (rows, count) = await HistoFilterSvc.SearchByFiltreReelAsync(filtre.FiltreReel ?? "");
            LoadedItems = rows;
            TotalCount = count;
            _hasMore = false;
            Selected = null;
        }
        catch (FormatException)
        {
            Error = "Ce filtre contient une syntaxe non reconnue et ne peut pas être exécuté pour le moment. Contactez un administrateur pour le corriger.";
        }
        catch (Exception ex)
        {
            Error = FriendlyError.ToUserMessage(ex);
        }
    }

    private async Task ClearFilter()
    {
        await RefreshCount();
        await LoadInitial();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("mafaliScroll.attach", TableWrapRef, _dotNetRef);
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("mafaliScroll.detach", TableWrapRef);
        }
        catch (JSDisconnectedException)
        {
        }
        _dotNetRef?.Dispose();
    }

    private async Task RefreshCount()
    {
        try
        {
            TotalCount = await HistoriqueSvc.GetCountAsync();
            Error = null;
        }
        catch (Exception ex)
        {
            Error = FriendlyError.ToUserMessage(ex);
        }
    }

    private async Task LoadInitial()
    {
        LoadedItems = new();
        _lastLoadedId = null;
        _hasMore = true;
        try
        {
            var batch = await HistoriqueSvc.GetPagedAsync(null, BatchSize);
            LoadedItems = batch;
            _lastLoadedId = batch.Count > 0 ? batch[^1].IdHisto : null;
            _hasMore = batch.Count == BatchSize;
            Error = null;
        }
        catch (Exception ex)
        {
            Error = FriendlyError.ToUserMessage(ex);
        }
    }

    [JSInvokable]
    public async Task OnScrolledNearBottom()
    {
        if (_loadingMore || !_hasMore || LoadedItems.Count >= MaxLoadedRows) return;

        _loadingMore = true;
        StateHasChanged();
        try
        {
            var nextBatch = await HistoriqueSvc.GetPagedAsync(_lastLoadedId - 1, BatchSize);
            LoadedItems.AddRange(nextBatch);
            _lastLoadedId = nextBatch.Count > 0 ? nextBatch[^1].IdHisto : _lastLoadedId;
            _hasMore = nextBatch.Count == BatchSize;
            Error = null;
        }
        catch (Exception ex)
        {
            Error = FriendlyError.ToUserMessage(ex);
        }
        finally
        {
            _loadingMore = false;
            StateHasChanged();
        }
    }

    private void Select(long idHisto) => Selected = idHisto;

    private void OpenCreate() => Nav.NavigateTo("/historiques/new", forceLoad: true);

    private void OpenEdit()
    {
        if (Selected is null) return;
        OpenEditRow(Selected.Value);
    }

    private void OpenEditRow(long idHisto) => Nav.NavigateTo($"/historiques/{idHisto}/edit", forceLoad: true);

    private void OpenDeleteConfirm()
    {
        if (Selected is null) return;
        ConfirmDeleteOpen = true;
    }

    private async Task ConfirmDelete()
    {
        if (Selected is null) return;
        ConfirmDeleteOpen = false;
        Submitting = true;
        Error = null;
        try
        {
            await HistoriqueSvc.DeleteAsync(Selected.Value);
            Selected = null;
            await RefreshCount();
            await LoadInitial();
        }
        catch (Exception ex)
        {
            Error = FriendlyError.ToUserMessage(ex);
        }
        finally
        {
            Submitting = false;
        }
    }

    private static string GetCellText(Historique h, string key) => key switch
    {
        "num_client" => h.NumClient.ToString(),
        "date_saisie" => h.DateSaisie?.ToString("dd/MM/yyyy") ?? "",
        "heure_saisie" => h.HeureSaisie?.ToString("HH:mm") ?? "",
        "assistante_commercial" => h.AssistanteCommercial ?? "",
        "date_rappel" => h.DateRappel?.ToString("dd/MM/yyyy") ?? "",
        "heure_rappel" => h.HeureRappel?.ToString("HH:mm") ?? "",
        "operation" => h.Operation ?? "",
        "status_vente" => h.StatusVente ?? "",
        "note" => h.Note ?? "",
        "franchise" => h.Franchise ?? "",
        "n_adherent" => h.NAdherent ?? "",
        "franchise2" => h.Franchise2 ?? "",
        "n_adherent2" => h.NAdherent2 ?? "",
        "franchise3" => h.Franchise3 ?? "",
        "n_adherent3" => h.NAdherent3 ?? "",
        "franchise4" => h.Franchise4 ?? "",
        "n_adherent4" => h.NAdherent4 ?? "",
        "raison_sociale" => h.RaisonSociale ?? "",
        "cp" => h.Cp ?? "",
        "ville" => h.Ville ?? "",
        "statuts_clients" => h.StatutsClients ?? "",
        "magasin_principal" => h.MagasinPrincipal ?? "",
        "id_histo" => h.IdHisto.ToString(),
        _ => "",
    };

    private static string StatutBadgeClass(string? statut) => statut switch
    {
        "Payés" => "badge-success",
        "Impayés" => "badge-warning",
        "Bloqués" => "badge-danger",
        _ => "",
    };
}
