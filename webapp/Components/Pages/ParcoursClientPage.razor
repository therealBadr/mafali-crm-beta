        {
            using var buffered = new MemoryStream();
            await e.File.OpenReadStream(MaxAttachmentFileSize).CopyToAsync(buffered);
            PendingAttachmentBytes = buffered.ToArray();
            PendingAttachmentFileName = e.File.Name;
