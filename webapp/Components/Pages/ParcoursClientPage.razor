    private bool InterModifClientDisabled => BlockedGate || !InterMajClient;
    private bool StatusDisabled => BlockedGate || (!InterMajClient && Client?.OpEnCours != "Vente en Cours");

    private string? CurrentMask => Client?.Pays is not null && PaysByName.TryGetValue(Client.Pays, out var p) ? p.Masque : null;
    private string? CurrentIndicatif => Client?.Pays is not null && PaysByName.TryGetValue(Client.Pays, out var p) ? p.Indicatif : null;

    private string ReturnUrl => Mode switch
    {
        "filtre" => "/filtres-predefinis",
        "recherche" => "/recherche-client",
        "mes-ajouts" => "/mes-clients-ajoutes",
        _ => "/clients",
    };

    protected override async Task OnInitializedAsync()
    {
        DatePromptValue = Clock.Today;
        Loading = true;
        try
        {
            IsCommercial = await CurrentUser.GetRoleAsync() == "commercial";
            CurrentLogin = await CurrentUser.GetLoginAsync();
            FamilleOptions = await FamilleSvc.ListAsync();
            FranchiseOptions = await FranchiseSvc.ListAsync();
            var paysList = await PaysSvc.ListAsync();
            PaysOptions = paysList.Select(p => p.NomPays).ToList();
            PaysByName = paysList.ToDictionary(p => p.NomPays, p => p);

            if (Mode == "filtre" && !string.IsNullOrEmpty(QueryAssistante) && !string.IsNullOrEmpty(QueryFiltre))
            {
                var filtres = await FiltreSvc.ListByOperatorAsync(QueryAssistante);
                var f = filtres.FirstOrDefault(x => x.NomFiltre == QueryFiltre);
                if (f is not null)
                {
                    try
                    {
                        var (rows, _) = await ClientFilterSvc.SearchByFiltreReelAsync(f.FiltreReel ?? "");
                        ClientIds = rows.Select(r => r.CleOpl).ToList();
                    }
                    catch (FormatException)
                    {
                        Error = "Ce filtre contient une syntaxe non reconnue et ne peut pas être exécuté.";
                    }
                }
            }
            else if (Mode == "recherche" && !string.IsNullOrEmpty(QueryCriteria))
            {
                var conditions = JsonSerializer.Deserialize<List<Condition>>(QueryCriteria) ?? new();
                var (rows, _) = await ClientFilterSvc.SearchAsync(conditions);
                ClientIds = rows.Select(r => r.CleOpl).ToList();
            }
            else if (Mode == "mes-ajouts")
            {
                var login = await CurrentUser.GetLoginAsync();
                ClientIds = login is null ? new() : await ValidationSvc.ListIdsByAdderAsync(login);
                if (ClientIds.Count == 0)
                {
                    Error = "Vous n'avez aucun client consultable.";
                }
            }
            else
            {
                ClientIds = await ClientSvc.ListIdsAsync();
            }

            if (ClientIds.Count == 0)
            {
                if (Error is null) Error = "Aucun client à afficher.";
                return;
            }

            CurrentIndex = Start.HasValue ? ClientIds.IndexOf(Start.Value) : 0;
            if (CurrentIndex < 0) CurrentIndex = 0;

            await LoadCurrent();
        }
        catch (Exception ex)
        {
            Error = FriendlyError.ToUserMessage(ex);
        }
        finally
        {
            Loading = false;
        }
    }

    private async Task LoadCurrent()
