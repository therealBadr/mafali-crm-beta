    private async Task SaveAsync(bool force)
    {
        if (Client is null || Baseline is null) return;
        Submitting = true;
        Error = null;
        try
        {
            var now = Clock.LocalNow;
            Client.DateSaisie = DateOnly.FromDateTime(now);
            Client.HeureSaisie = TimeOnly.FromDateTime(now);

            var result = await ClientSvc.UpdateFullWithConflictCheckAsync(Client.CleOpl, Baseline, ParcoursClientInput.FromEntity(Client), force);
            if (!result.Success)
            {
                Conflicts = result.Conflicts;
                ConflictDialogOpen = true;
                return;
            }

            var histo = new HistoriqueInput
            {
                DateSaisie = Client.DateSaisie,
                HeureSaisie = Client.HeureSaisie,
                DateRappel = Client.DateRappel,
                HeureRappel = Client.HeureRappel,
                AssistanteCommercial = Client.AssistanteCommercial,
                Note = Client.Note,
                Franchise = Client.Franchise,
                NAdherent = Client.NAdherent,
                Franchise2 = Client.Franchise2,
                NAdherent2 = Client.NAdherent2,
                Franchise3 = Client.Franchise3,
                NAdherent3 = Client.NAdherent3,
                Franchise4 = Client.Franchise4,
                NAdherent4 = Client.NAdherent4,
                RaisonSociale = Client.RaisonSociale,
                Cp = Client.Cp,
                Ville = Client.Ville,
                MagasinPrincipal = Client.MagasinPrincipal,
                StatutsClients = Client.StatutsClients,
                Operation = Client.OpEnCours switch
                {
                    "A Rappeler Mois" or "A Rappeler Date" or "A Rappeler Date Heure" => "A Rappeler le ",
                    "Pas Intéressé" => $"Non intéressé le {DateOnly.FromDateTime(now):dd/MM/yyyy}, à recontacter le : ",
                    "Vente en Cours" => "Vente en Cours",
                    _ => null,
                },
                StatusVente = Client.StatusVente is null or "-1" ? null : Client.StatusVente,
                FicStk = PendingAttachmentBytes,
                FicStkNom = PendingAttachmentBytes is not null ? PendingAttachmentFileName : null,
            };
            await HistoriqueSvc.CreateAsync(Client.CleOpl, histo);
            PendingAttachmentBytes = null;
            PendingAttachmentFileName = null;

            if (CurrentIndex < ClientIds.Count - 1)
            {
                CurrentIndex++;
                await LoadCurrent();
            }
            else
            {
                InfoMessage = "Enregistré. C'est le dernier enregistrement.";
                await LoadCurrent();
            }
        }
        catch (Exception ex)
        {
            Error = FriendlyError.ToUserMessage(ex);
        }
        finally
        {
            Submitting = false;
        }
    }

