@page "/parcours-client"
@using System.Text.Json
@using PaysModel = MafaliCrm.Web.Models.Pays
@inject ClientService ClientSvc
@inject ClientFilterService ClientFilterSvc
@inject FiltreOperatriceService FiltreSvc
@inject HistoriqueService HistoriqueSvc
@inject CaService CaSvc
@inject FamilleService FamilleSvc
@inject FranchiseService FranchiseSvc
@inject PaysService PaysSvc
@inject BonCommandeTemplateService BcTemplateSvc
@inject ClientValidationService ValidationSvc
@inject CurrentUserService CurrentUser
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject UserClock Clock
@implements IAsyncDisposable

<PageTitle>@(Client?.RaisonSociale?.Trim() is { Length: > 0 } clientName ? $"{clientName} – Parcours Client" : "Parcours Client")</PageTitle>

<div class="pc-page page-flush">
@if (Loading)
{
    <p class="dimmed">Chargement…</p>
}
else if (Error is not null && Client is null)
{
    <div class="alert">@Error</div>
}
else if (Client is not null)
{
    <div class="pc-topbar">
        <div class="pc-topbar-group">
            <span class="pc-title">Parcours Client</span>
            <label>Identifiant Client :</label>
            <input class="text-input pc-id" value="@Client.CleOpl" disabled />
        </div>
        <div class="pc-topbar-group">
            <span class="pc-position">@(CurrentIndex + 1) / @ClientIds.Count</span>
            <button class="btn btn-outline pc-nav-arrow" @onclick="GoFirst" title="Premier">|&lt;</button>
            <button class="btn btn-outline pc-nav-arrow" @onclick="GoPrevious" title="Précédent">&lt;</button>
            <button class="btn btn-outline pc-nav-arrow" @onclick="GoNext" title="Suivant">&gt;</button>
            <button class="btn btn-outline pc-nav-arrow" @onclick="GoLast" title="Dernier">&gt;|</button>
            <input class="text-input pc-goto" type="number" min="1" max="@ClientIds.Count"
                   @bind-value="GoToInput" @bind-value:event="oninput"
                   placeholder="N°" title="Aller à la position N°" @onkeydown="OnGoToKeyDown" />
            <button class="btn btn-outline" @onclick="GoToPosition" title="Aller à cette position">Aller</button>
            @if (InfoMessage is not null)
            {
                <span class="result-count">@InfoMessage</span>
            }
        </div>
        <div class="pc-topbar-group">
            <label>Etat Client</label>
            <select class="text-input pc-select-sm" value="@(Client.EtatClient == "1" ? "1" : "2")" disabled="@MajDisabled"
                    @onchange="e => Client!.EtatClient = e.Value?.ToString()">
                <option value="1">Client</option>
                <option value="2">Prospect</option>
            </select>
            <label class="checkbox-label" style="margin-bottom: 0;">
                <input type="checkbox" checked="@Client.Bloque" disabled="@IsCommercial" @onchange="e => Client!.Bloque = (bool)(e.Value ?? false)" />
                Bloqué
            </label>
            @if (Client.Bloque)
            {
                <span class="badge badge-gray">Enregistrement bloqué</span>
            }
            @if (Client.ValidationStatus == "pending")
            {
                <span class="badge badge-info">Non validé</span>
            }
        </div>
    </div>

    @if (Error is not null)
    {
        <div class="alert">@Error</div>
    }

    <div class="pc-body-wrap">
    <div class="pc-body">
    <div class="pc-cols-pair">
        <div class="pc-col pc-col-identite">
            <h4 class="pc-col-title">Identité / Adresse</h4>
            <div class="pc-field">
                <label>Type de Famille :</label>
                <select class="text-input" value="@(Client.Famille ?? "")" disabled="@InterModifClientDisabled"
                        @onchange="e => Client!.Famille = string.IsNullOrEmpty(e.Value?.ToString()) ? null : e.Value.ToString()">
                    <option value="">—</option>
                    @foreach (var f in FamilleOptions)
                    {
                        <option value="@f">@f</option>
                    }
                </select>
            </div>
            <div class="pc-field">
                <label>Raison Sociale</label>
                <input class="text-input" maxlength="60" value="@Client.RaisonSociale" disabled="@InterModifClientDisabled"
                       @oninput="e => Client!.RaisonSociale = e.Value?.ToString()" />
            </div>
            <div class="pc-field-row">
                <div class="pc-field">
                    <label>Complement</label>
                    <input class="text-input" maxlength="60" value="@Client.Complement" disabled="@InterModifClientDisabled"
                           @oninput="e => Client!.Complement = e.Value?.ToString()" />
                </div>
                <div class="pc-field">
                    <label>Rue</label>
                    <input class="text-input" maxlength="60" value="@Client.Rue" disabled="@InterModifClientDisabled"
                           @oninput="e => Client!.Rue = e.Value?.ToString()" />
                </div>
            </div>
            <div class="pc-field-row">
                <div class="pc-field">
                    <label>Localisation 1</label>
                    <input class="text-input" maxlength="60" value="@Client.Localisation1" disabled="@InterModifClientDisabled"
                           @oninput="e => Client!.Localisation1 = e.Value?.ToString()" />
                </div>
                <div class="pc-field">
                    <label>Localisation 2</label>
                    <input class="text-input" maxlength="60" value="@Client.Localisation2" disabled="@InterModifClientDisabled"
                           @oninput="e => Client!.Localisation2 = e.Value?.ToString()" />
                </div>
            </div>
            <div class="pc-field-row">
                <div class="pc-field">
                    <label>Code Postal</label>
                    <input class="text-input" maxlength="5" value="@Client.Cp" disabled="@InterModifClientDisabled"
                           @oninput="e => Client!.Cp = e.Value?.ToString()" />
                </div>
                <div class="pc-field" style="flex: 2;">
                    <label>Ville</label>
                    <input class="text-input" maxlength="40" value="@Client.Ville" disabled="@InterModifClientDisabled"
                           @oninput="e => Client!.Ville = e.Value?.ToString()" />
                </div>
            </div>
            <div class="pc-field-row">
                <div class="pc-field">
                    <label>Pays</label>
                    <select class="text-input" value="@(Client.Pays ?? "")" disabled="@InterModifClientDisabled"
                            @onchange="e => Client!.Pays = string.IsNullOrEmpty(e.Value?.ToString()) ? null : e.Value.ToString()">
                        <option value="">—</option>
                        @foreach (var p in PaysOptions)
                        {
                            <option value="@p">@p</option>
                        }
                    </select>
                </div>
                <div class="pc-field" style="flex: 2;">
                    <label>Magasin Principal</label>
                    <input class="text-input" maxlength="50" value="@Client.MagasinPrincipal" disabled="@InterModifClientDisabled"
                           @oninput="e => Client!.MagasinPrincipal = e.Value?.ToString()" />
                </div>
            </div>
            @if (!IsCommercial)
            {
                <div class="pc-field-row">
                    <div class="pc-field" style="flex: 2;">
                        <label>État du Magasin</label>
                        <select class="text-input" value="@(Client.MagasinFerme ?? "")" disabled="@InterModifClientDisabled"
                                @onchange="e => Client!.MagasinFerme = string.IsNullOrEmpty(e.Value?.ToString()) ? null : e.Value.ToString()">
                            <option value="">Ouvert</option>
                            <option value="Fermé temporairement">Fermé temporairement</option>
                            <option value="Fermé définitivement">Fermé définitivement</option>
                        </select>
                    </div>
                </div>
            }
            <div class="pc-field-row pc-franchise-row">
                <div class="pc-field-pair">
                    <div class="pc-field">
                        <label>Franchise</label>
                        <select class="text-input" value="@(Client.Franchise ?? "")" disabled="@InterModifClientDisabled"
                                @onchange="e => Client!.Franchise = string.IsNullOrEmpty(e.Value?.ToString()) ? null : e.Value.ToString()">
                            <option value="">—</option>
                            @foreach (var f in FranchiseOptions)
                            {
                                <option value="@f">@f</option>
                            }
                        </select>
                    </div>
                    <div class="pc-field pc-adherent-field">
                        <label>N° Adhérent</label>
                        <input class="text-input" maxlength="20" value="@Client.NAdherent" disabled="@InterModifClientDisabled"
                               @oninput="e => Client!.NAdherent = e.Value?.ToString()" />
                    </div>
                </div>
                <div class="pc-field-pair">
                    <div class="pc-field">
                        <label>Franchise 2</label>
                        <select class="text-input" value="@(Client.Franchise2 ?? "")" disabled="@InterModifClientDisabled"
                                @onchange="e => Client!.Franchise2 = string.IsNullOrEmpty(e.Value?.ToString()) ? null : e.Value.ToString()">
                            <option value="">—</option>
                            @foreach (var f in FranchiseOptions)
                            {
                                <option value="@f">@f</option>
                            }
                        </select>
                    </div>
                    <div class="pc-field pc-adherent-field">
                        <label>N° Adhérent 2</label>
                        <input class="text-input" maxlength="20" value="@Client.NAdherent2" disabled="@InterModifClientDisabled"
                               @oninput="e => Client!.NAdherent2 = e.Value?.ToString()" />
                    </div>
                </div>
            </div>
            <div class="pc-field-row pc-franchise-row">
                <div class="pc-field-pair">
                    <div class="pc-field">
                        <label>Franchise 3</label>
                        <select class="text-input" value="@(Client.Franchise3 ?? "")" disabled="@InterModifClientDisabled"
                                @onchange="e => Client!.Franchise3 = string.IsNullOrEmpty(e.Value?.ToString()) ? null : e.Value.ToString()">
                            <option value="">—</option>
                            @foreach (var f in FranchiseOptions)
                            {
                                <option value="@f">@f</option>
                            }
                        </select>
                    </div>
                    <div class="pc-field pc-adherent-field">
                        <label>N° Adhérent 3</label>
                        <input class="text-input" maxlength="20" value="@Client.NAdherent3" disabled="@InterModifClientDisabled"
                               @oninput="e => Client!.NAdherent3 = e.Value?.ToString()" />
                    </div>
                </div>
                <div class="pc-field-pair">
                    <div class="pc-field">
                        <label>Franchise 4</label>
                        <select class="text-input" value="@(Client.Franchise4 ?? "")" disabled="@InterModifClientDisabled"
                                @onchange="e => Client!.Franchise4 = string.IsNullOrEmpty(e.Value?.ToString()) ? null : e.Value.ToString()">
                            <option value="">—</option>
                            @foreach (var f in FranchiseOptions)
                            {
                                <option value="@f">@f</option>
                            }
                        </select>
                    </div>
                    <div class="pc-field pc-adherent-field">
                        <label>N° Adhérent 4</label>
                        <input class="text-input" maxlength="20" value="@Client.NAdherent4" disabled="@InterModifClientDisabled"
                               @oninput="e => Client!.NAdherent4 = e.Value?.ToString()" />
                    </div>
                </div>
            </div>
            <div class="pc-field pc-note-field">
                <label>Notes :</label>
                <textarea class="text-input pc-note" value="@Client.Note" disabled="@(!InterModifNote)"
                          @oninput="e => Client!.Note = e.Value?.ToString()"></textarea>
            </div>
            <label class="checkbox-label pc-note-modif">
                <input type="checkbox" checked="@InterModifNote" disabled="@BlockedGate"
                       @onchange="e => InterModifNote = (bool)(e.Value ?? false)" />
                Modifier la Note
            </label>
        </div>

        <div class="pc-col">
            <h4 class="pc-col-title">Contact / Opération en cours</h4>
            <div class="pc-field-row">
                <div class="pc-field">
                    <label>Assistante Commerciale :</label>
                    <input class="text-input" value="@Client.AssistanteCommercial" disabled />
                </div>
                <div class="pc-field">
                    <label>Responsable Achats :</label>
                    <input class="text-input" maxlength="50" value="@Client.ResponsableAchat" disabled="@MajDisabled"
                           @oninput="e => Client!.ResponsableAchat = e.Value?.ToString()" />
                </div>
            </div>
            <div class="pc-field-row">
                <div class="pc-field" style="flex: 2;">
                    <label>Telephone :</label>
                    <input class="text-input pc-phone-primary" maxlength="20" value="@Client.Telephone" disabled="@MajDisabled"
                           placeholder="@CurrentMask" @oninput="e => Client!.Telephone = e.Value?.ToString()" />
                </div>
                <div class="pc-field">
                    <label>Indicatif</label>
                    <input class="text-input" value="@CurrentIndicatif" disabled />
                </div>
            </div>
            <div class="pc-field">
                <label>Telephone Bis</label>
                <input class="text-input" maxlength="20" value="@Client.TelBis"
                       @oninput="e => Client!.TelBis = e.Value?.ToString()" />
            </div>
            <div class="pc-field-row">
                <div class="pc-field">
                    <label>Portable</label>
                    <input class="text-input" maxlength="20" value="@Client.Portable" disabled="@MajDisabled"
                           @oninput="e => Client!.Portable = e.Value?.ToString()" />
                </div>
            </div>
            <div class="pc-field-row">
                <div class="pc-field">
                    <label>Opération :</label>
                    <select class="text-input" value="@(Client.OpEnCours ?? "")" disabled="@MajDisabled" @onchange="OnOperationChange">
                        <option value="">—</option>
                        <option value="A Rappeler Mois">A Rappeler Mois</option>
                        <option value="A Rappeler Date">A Rappeler Date</option>
                        <option value="A Rappeler Date Heure">A Rappeler Date Heure</option>
                        <option value="Pas Intéressé">Pas Intéressé</option>
                        <option value="Vente en Cours">Vente en Cours</option>
                        <option value="Production">Production</option>
                    </select>
                </div>
                <div class="pc-field">
                    <label>Status de la Vente :</label>
                    <select class="text-input" value="@(Client.StatusVente ?? "-1")" disabled="@StatusDisabled" @onchange="OnStatusChange">
                        <option value="-1">—</option>
                        <option value="Devis en cours">Devis</option>
                        <option value="Vente (BAT Original)">BAT</option>
                        <option value="Vente (BAT Signé)">BAT signé</option>
                        <option value="Vente (Bon de Commande)">Bon de commande</option>
                        <option value="Vente Annulée">Vente Annulée</option>
                        <option value="Production">Production</option>
                    </select>
                </div>
            </div>
            @if (ShowProduction)
            {
                <div class="pc-field">
                    <label>Production</label>
                    <select class="text-input" value="@(Client.Production ?? "")" disabled="@MajDisabled"
                            @onchange="e => Client!.Production = string.IsNullOrEmpty(e.Value?.ToString()) ? null : e.Value.ToString()">
                        <option value="">—</option>
                        @foreach (var s in ProductionStages)
                        {
                            <option value="@s">@s</option>
                        }
                    </select>
                </div>
            }
            <div class="pc-field-row">
                <div class="pc-field">
                    <label>Date Rappel :</label>
                    <DateInput Value="Client!.DateRappel" ValueChanged="v => Client!.DateRappel = v" Disabled="MajDisabled" />
                </div>
                <div class="pc-field">
                    <label>Heure Rappel :</label>
                    <TimeInput Value="Client!.HeureRappel" ValueChanged="v => Client!.HeureRappel = v" Disabled="MajDisabled" />
                </div>
            </div>
            <label class="checkbox-label">
                <input type="checkbox" checked="@Client.RappelRdv" @onchange="e => Client!.RappelRdv = (bool)(e.Value ?? false)" />
                Rappel RDV
            </label>
            <div class="pc-field">
                <label>Statut Client :</label>
                <select class="text-input" value="@(Client.StatutsClients ?? "-1")" disabled="@InterModifClientDisabled"
                        @onchange="e => Client!.StatutsClients = e.Value?.ToString()">
                    <option value="-1">—</option>
                    <option value="Payés">Payés</option>
                    <option value="Impayés">Impayés</option>
                    <option value="Bloqués">Bloqués</option>
                </select>
            </div>
            <div class="pc-field">
                <label>Email</label>
                <input class="text-input" type="email" maxlength="50" value="@Client.Email" disabled="@InterModifClientDisabled"
                       @oninput="e => Client!.Email = e.Value?.ToString()" />
            </div>
            <div class="pc-field">
                <label>Email 2</label>
                <input class="text-input" type="email" maxlength="50" value="@Client.Email2" disabled="@InterModifClientDisabled"
                       @oninput="e => Client!.Email2 = e.Value?.ToString()" />
            </div>
            @if (!IsCommercial)
            {
                <label class="checkbox-label">
                    <input type="checkbox" checked="@Client.PasEmailing" disabled="@InterModifClientDisabled"
                           @onchange="e => Client!.PasEmailing = (bool)(e.Value ?? false)" />
                    Pas d'Emailing
                </label>
            }
            <a href="/recherche-client" target="_blank" class="btn btn-default pc-search-client">
                Rechercher un Client
            </a>
        </div>

    </div>

        <div class="pc-col">
            <h4 class="pc-col-title">Chiffre d'Affaire</h4>
            <div class="pc-ca-note-row">
                <div class="pc-ca-panel">
                    <div class="pc-ca-list">
                        @if (CaList.Count == 0)
                        {
                            <p class="dimmed" style="padding: 8px;">Aucun chiffre d'affaire enregistré.</p>
                        }
                        else
                        {
                            @foreach (var ca in CaList)
                            {
                                <div class="pc-ca-row">
                                    <span>@ca.Annee</span>
                                    <span>---&gt;</span>
                                    <span>@(ca.Ca1?.ToString() ?? "0")</span>
                                </div>
                            }
                        }
                    </div>
                    <button class="btn btn-default" style="width: 100%; margin-top: 8px;" @onclick="OpenCaModal" disabled="@MajDisabled">
                        Ajout/Modif. CA
                    </button>
                </div>
                <div class="pc-field pc-note-perm-field">
                    <label>Note Permanente</label>
                    <textarea class="text-input pc-note-perm" disabled="@InterModifClientDisabled"
                              @oninput="e => Client!.NotePerm = e.Value?.ToString()">@Client.NotePerm</textarea>
                </div>
            </div>
            <label class="checkbox-label" style="margin-top: 12px;">
                <input type="checkbox" checked="@InterMajClient" disabled="@BlockedGate"
                       @onchange="e => InterMajClient = (bool)(e.Value ?? false)" />
                Mettre à jour les informations du client
            </label>
            <div class="pc-field-row" style="margin-top: 12px;">
                <div class="pc-field">
                    <label>SIRET</label>
                    <input class="text-input" maxlength="14" value="@Client.Siret" disabled="@InterModifClientDisabled"
                           @oninput="e => Client!.Siret = e.Value?.ToString()" />
                </div>
                <div class="pc-field">
                    <label>SIREN</label>
                    <input class="text-input" maxlength="9" value="@Client.Siren" disabled="@InterModifClientDisabled"
                           @oninput="e => Client!.Siren = e.Value?.ToString()" />
                </div>
            </div>
            <div class="pc-field-row">
                <div class="pc-field">
                    <label>TVA</label>
                    <input class="text-input" maxlength="20" value="@Client.Tva" disabled="@InterModifClientDisabled"
                           @oninput="e => Client!.Tva = e.Value?.ToString()" />
                </div>
            </div>
            <div class="pc-field">
                <label class="checkbox-label">
                    <input type="checkbox" checked="@Client.FacturationElectronique" disabled="@InterModifClientDisabled"
                           @onchange="e => Client!.FacturationElectronique = (bool)(e.Value ?? false)" />
                    Facturation Électronique
                </label>
            </div>
        </div>
    </div>
    @if (Client.Bloque)
    {
        <div class="pc-blocked-overlay">
            <span class="pc-blocked-text">Enregistrement bloqué</span>
        </div>
    }
    </div>

    <div class="grid-group show-grip">
    <div class="pc-actions">
        <button class="btn btn-default" @onclick="Cancel">Annuler modification</button>
        <button class="btn btn-primary" disabled="@(Submitting || Client.Bloque)" @onclick="OpenApplyConfirm">Appliquer</button>
        <button class="btn btn-default" @onclick="Close">Fermer</button>
        <div class="pc-actions-right">
            <button class="btn btn-default" disabled="@(SelectedHistoId is null)" @onclick="DownloadStoredFile">
                Voir le Fichier Stocké
            </button>
            <button class="btn btn-default" disabled="@(Client.Bloque || BcGenerating)" @onclick="GenerateBonCommande">
                Générer fichier bon de commande
            </button>
            @if (PendingBcBytes is not null)
            {
                <button class="btn btn-default" @onclick="RedownloadBonCommande">
                    Télécharger à nouveau
                </button>
            }
        </div>
    </div>

    <GridFilterClearAll Filter="HistoFilter" OnFilterChanged="StateHasChanged" />
    <div class="pc-histo table-wrap">
        <div style="width: 100%; min-width: @(HistoTotalWidth)px;">
            <div class="header-row" style="position: sticky; top: 0;" @ref="HistoHeaderRowRef">
                @foreach (var col in HistoColumns)
                {
                    <div class="cell" style="flex: @(HistoCellFlex(col.Key)) @(col.Width)px;">
                        <span class="col-sort-label @HistoSort.CssClass(col.Key)" @onclick='() => HistoSort.Toggle(col.Key)'>@col.Label @HistoSort.ArrowFor(col.Key)</span>
                        <ColumnFilterIcon Column="@col.Key" Label="@col.Label" Filter="HistoFilter" OnFilterChanged="StateHasChanged" />
                        <span class="col-resize-handle" data-col-key="@col.Key"></span>
                    </div>
                }
            </div>
            @if (HistoList.Count == 0)
            {
                <p class="dimmed">Aucun historique pour ce client.</p>
            }
            else
            {
                <Virtualize Items="SortedHistoList" Context="h" ItemSize="34">
                    <div class="row @(h.IdHisto == SelectedHistoId ? "selected" : "")" @onclick="() => SelectedHistoId = h.IdHisto">
                        @foreach (var col in HistoColumns)
                        {
                            <div class="cell" style="flex: @(HistoCellFlex(col.Key)) @(col.Width)px;">@GetHistoCellText(h, col.Key)</div>
                        }
                    </div>
                </Virtualize>
            }
        </div>
    </div>
    </div>
}
</div>

@if (ConfirmApplyOpen)
{
    <div class="modal-backdrop" @onclick="() => ConfirmApplyOpen = false">
        <div class="modal" @onclick:stopPropagation="true">
            <h3>Confirmer</h3>
            <p class="confirm-text">Etes-vous sûr de vouloir enregistrer les modifications ?</p>
            <div class="modal-actions">
                <button class="btn btn-default" @onclick="() => ConfirmApplyOpen = false">Annuler</button>
                <button class="btn btn-primary" disabled="@Submitting" @onclick="ConfirmApply">Valider</button>
            </div>
        </div>
    </div>
}

@if (ConflictDialogOpen)
{
    <div class="modal-backdrop" @onclick="() => ConflictDialogOpen = false">
        <div class="modal" @onclick:stopPropagation="true">
            <h3>Conflit détecté</h3>
            <p class="confirm-text">
                Ce client a été modifié par quelqu'un d'autre pendant que vous le modifiiez.
                Voici les champs concernés :
            </p>
            <div class="conflict-list">
                @foreach (var c in Conflicts)
                {
                    <div class="conflict-row">
                        <span class="conflict-field">@c.Field</span>
                        <span class="conflict-values">Vous : @c.MyValue — Actuel : @c.CurrentValue</span>
                    </div>
                }
            </div>
            <div class="modal-actions">
                <button class="btn btn-default" @onclick="ReloadAfterConflict">Recharger</button>
                <button class="btn btn-primary" disabled="@Submitting" @onclick="ForceApply">Écraser quand même</button>
            </div>
        </div>
    </div>
}

@if (MonthsPromptOpen)
{
    <div class="modal-backdrop" @onclick="() => MonthsPromptOpen = false">
        <div class="modal" @onclick:stopPropagation="true">
            <h3>Rappel</h3>
            <label>Saisir le nombre de mois avant le rappel :</label>
            <input class="text-input" type="number" min="1" max="60" value="@MonthsValue"
                   @oninput="e => MonthsValue = int.TryParse(e.Value?.ToString(), out var v) ? v : MonthsValue" />
            <div class="modal-actions">
                <button class="btn btn-default" @onclick="() => MonthsPromptOpen = false">Annuler</button>
                <button class="btn btn-primary" @onclick="ConfirmMonths">Valider</button>
            </div>
        </div>
    </div>
}

@if (DatePromptOpen)
{
    <div class="modal-backdrop" @onclick="() => DatePromptOpen = false">
        <div class="modal" @onclick:stopPropagation="true">
            <h3>Rappel</h3>
