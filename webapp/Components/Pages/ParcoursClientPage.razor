    private async Task Cancel() => await LoadCurrent();

    private void Close() => Nav.NavigateTo(ReturnUrl);

    private void OnOperationChange(ChangeEventArgs e)
    {
        if (Client is null) return;
        Client.OpEnCours = string.IsNullOrEmpty(e.Value?.ToString()) ? null : e.Value.ToString();
        switch (Client.OpEnCours)
        {
            case "A Rappeler Mois":
                MonthsValue = 4;
                MonthsPromptOpen = true;
                break;
            case "A Rappeler Date":
            case "A Rappeler Date Heure":
                DatePromptValue = Clock.Today;
                TimePromptValue = new(9, 0);
