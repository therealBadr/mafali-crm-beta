    private async Task DownloadStoredFile()
    {
        if (SelectedHistoId is null) return;
        Error = null;
        var histo = await HistoriqueSvc.GetByIdAsync(SelectedHistoId.Value);
        if (histo?.FicStk is null || histo.FicStk.Length == 0)
        {
            Error = "Aucun fichier n'est associé à cet enregistrement.";
            return;
        }
        using var stream = new MemoryStream(histo.FicStk);
        using var streamRef = new DotNetStreamReference(stream);
        var fileName = string.IsNullOrWhiteSpace(histo.FicStkNom) ? $"fichier_{histo.IdHisto}" : histo.FicStkNom;
        await JS.InvokeVoidAsync("mafaliFileDownload.downloadFileFromStream", fileName, "application/octet-stream", streamRef);
    }

    private const string XlsxContentType = "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet";

    private static BonCommandeTemplateType? DetectBcTemplateType(string? famille)
    {
        if (string.IsNullOrWhiteSpace(famille)) return null;
        var firstWord = famille.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? "";
        return firstWord.Equals("Opticien", StringComparison.OrdinalIgnoreCase)
            ? BonCommandeTemplateType.Optique
            : BonCommandeTemplateType.Revendeur;
    }

    private static string SanitizeForFileName(string? raisonSociale)
    {
        var name = string.IsNullOrWhiteSpace(raisonSociale) ? "Client" : raisonSociale.Trim();
        foreach (var c in Path.GetInvalidFileNameChars())
        {
            name = name.Replace(c, '-');
        }
        const int maxLength = 50;
        return name.Length > maxLength ? name[..maxLength].TrimEnd() : name;
    }

    private async Task GenerateBonCommande()
    {
        if (Client is null) return;
        Error = null;

        var type = DetectBcTemplateType(Client.Famille);
        if (type is null)
        {
            Error = "Impossible de déterminer le modèle de Bon de Commande : le champ « Type de Famille » n'est pas renseigné pour ce client.";
            return;
        }

        BcGenerating = true;
        try
        {
            var templateBytes = await BcTemplateSvc.GetBytesAsync(type.Value);
            if (templateBytes is null)
            {
                Error = $"Aucun modèle configuré pour « {(type == BonCommandeTemplateType.Optique ? "Optique" : "Revendeur")} ». Contactez un administrateur.";
                return;
            }

            var (filled, bcNumber) = await BcTemplateSvc.FillAsync(templateBytes, Client, type.Value);
            var fileName = $"BC - {bcNumber} - {SanitizeForFileName(Client.RaisonSociale)}.xlsx";

            var supported = await JS.InvokeAsync<bool>("mafaliBonCommandeDestination.isSupported");
            var folderName = supported ? await JS.InvokeAsync<string?>("mafaliBonCommandeDestination.getCurrentFolderName") : null;

            if (supported && folderName is not null)
            {
                using var stream = new MemoryStream(filled);
                using var streamRef = new DotNetStreamReference(stream);
                var result = await JS.InvokeAsync<string>("mafaliBonCommandeDestination.writeFile", fileName, streamRef);
                if (result == "ok")
                {
                    PendingBcBytes = filled;
                    PendingBcFileName = fileName;
                    BcSuccessFolder = folderName;
                    BcOpenPromptOpen = true;
                    return;
                }

                await DownloadBonCommandeBytes(filled, fileName);
                InfoMessage = "Fichier téléchargé (le dossier configuré n'était plus accessible — vous pouvez le choisir à nouveau depuis la page Bon de Commande).";
            }
            else
            {
                await DownloadBonCommandeBytes(filled, fileName);
                InfoMessage = "Fichier téléchargé.";
                PendingBcBytes = filled;
                PendingBcFileName = fileName;
            }
        }
        catch (Exception ex)
        {
            Error = FriendlyError.ToUserMessage(ex);
        }
